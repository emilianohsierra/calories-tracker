# Copia este archivo a .env.local y configura al menos un proveedor de IA.

# Proveedor a usar: openai | grok
# Si se omite, se usa automáticamente el que tenga clave configurada
# (OpenAI tiene prioridad si ambas claves existen).
#AI_PROVIDER=openai

# --- OpenAI (ChatGPT) --- https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Modelo de visión (por defecto gpt-4o-mini)
#OPENAI_MODEL=gpt-4o

# --- Grok (xAI) --- https://console.x.ai
#XAI_API_KEY=xai-...
# Modelo de visión (por defecto grok-4.3)
#XAI_MODEL=grok-4.3
