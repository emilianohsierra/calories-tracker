# Copia este archivo a .env.local y configura las claves.
# NO subas .env.local al repositorio (ya está en .gitignore).

# --- Claude (Anthropic) --- https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Modelo de visión (por defecto claude-haiku-4-5)
#ANTHROPIC_MODEL=claude-haiku-4-5

# --- Supabase --- Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Freemium ---
# Solo para mostrar "análisis restantes" en la UI. La aplicación REAL del límite vive
# en la tabla app_config de Supabase (se cambia con un UPDATE, sin tocar código).
FREE_ANALYSIS_LIMIT=10
