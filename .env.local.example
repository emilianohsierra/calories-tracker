# Copia este archivo a .env.local y configura la clave de Claude (Anthropic).

# Proveedor a usar (opcional). Único valor soportado: anthropic
#AI_PROVIDER=anthropic

# --- Claude (Anthropic) --- https://console.anthropic.com/settings/keys
# Obligatorio. NO la subas al repositorio (.env.local está en .gitignore).
ANTHROPIC_API_KEY=sk-ant-...
# Modelo de visión (por defecto claude-haiku-4-5)
#ANTHROPIC_MODEL=claude-haiku-4-5
