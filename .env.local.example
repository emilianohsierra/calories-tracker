# Copia este archivo a .env.local y configura las claves.
# NO subas .env.local al repositorio (ya está en .gitignore).

# --- Claude (Anthropic) --- https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Modelo de visión (por defecto claude-haiku-4-5)
#ANTHROPIC_MODEL=claude-haiku-4-5

# --- Supabase --- Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Freemium ---
# Solo para mostrar "análisis restantes" en la UI. La aplicación REAL del límite vive
# en la tabla app_config de Supabase (se cambia con un UPDATE, sin tocar código).
FREE_ANALYSIS_LIMIT=10

# --- Stripe (monetización) --- Dashboard → Developers
# Secreta (servidor). Test: sk_test_... / Producción: sk_live_...
STRIPE_SECRET_KEY=sk_test_...
# Firma del webhook (Developers → Webhooks → tu endpoint → Signing secret). Distinta en test/prod.
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ID del plan Pro mensual (Product catalog → Pro → precio). El anual se agrega luego.
STRIPE_PRICE_PRO=price_...
# URL pública del sitio para success/cancel/return de Stripe.
NEXT_PUBLIC_SITE_URL=http://localhost:7350

# --- Supabase service_role --- ⚠️ SOLO para el webhook de Stripe. Variable de SERVIDOR.
# NUNCA la pongas con prefijo NEXT_PUBLIC_ ni la expongas al navegador. Bypassa RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
